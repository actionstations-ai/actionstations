{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Laboratory figure (board, trend or table)",
  "description": "A board, trend or table for a laboratory incident exercise, drawn by the app from data (never an image): the notification clock board, the freezer temperature and alarm trend, the inventory reconciliation with the discrepancy flagged, the sample loss register and the access log extract. Each carries a text summary and a data table. All data are exercise data.",
  "type": "object",
  "required": ["figures"],
  "additionalProperties": false,
  "properties": {
    "heading": {
      "type": "string",
      "description": "Heading above the figure",
      "examples": ["Notification clocks"]
    },
    "source": {
      "type": "string",
      "description": "Where the data come from",
      "examples": ["Exercise data, simulated"],
      "x-translate": false
    },
    "hideTable": {
      "type": "boolean",
      "description": "Leave out the data table beside the figure"
    },
    "figures": {
      "type": "object",
      "description": "The figure to draw as { main: { kind, data } }.",
      "required": ["main"],
      "additionalProperties": false,
      "properties": {
        "main": {
          "type": "object",
          "required": ["kind", "data"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "lab_notification_clock_board",
                "lab_temperature_alarm_trend",
                "lab_inventory_reconciliation",
                "lab_sample_loss_register",
                "lab_access_log"
              ]
            },
            "data": {
              "type": "object",
              "description": "Data for the kind"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
