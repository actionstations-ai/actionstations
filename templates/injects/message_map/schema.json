{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message map and Q&A",
  "description": "A one-page plan for a spokesperson: the key messages with proof points, hard questions with answers consistent with the fact sheet, and what not to say. The organization and people are fictional.",
  "type": "object",
  "required": ["org", "title", "keyMessages"],
  "properties": {
    "org": {
      "type": "string",
      "description": "Organization (fictional)",
      "examples": ["Halyard Components, Inc."],
      "x-translate": false
    },
    "title": {
      "type": "string",
      "description": "Title of the message map",
      "examples": ["Data security incident: message map"]
    },
    "issuedAt": {
      "type": "string",
      "description": "Date and time prepared, consistent with the exercise clock",
      "examples": ["November 4, 2026 · 3:40 PM ET"],
      "x-translate": false
    },
    "audience": {
      "type": "string",
      "description": "Who the messages are for",
      "examples": ["Customers, employees and local media"]
    },
    "keyMessages": {
      "type": "array",
      "description": "Three or so key messages, each with proof points",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "description": "One sentence a spokesperson can repeat"
          },
          "proofPoints": {
            "type": "array",
            "description": "Facts that support the message",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "hardQuestions": {
      "type": "array",
      "description": "Hard questions with the answer to give",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "properties": {
          "question": {
            "type": "string",
            "description": "The question a reporter might ask"
          },
          "answer": {
            "type": "string",
            "description": "The answer, consistent with the fact sheet"
          }
        },
        "additionalProperties": false
      }
    },
    "doNotSay": {
      "type": "array",
      "description": "Things not to say",
      "items": {
        "type": "string"
      }
    },
    "approvedBy": {
      "type": "string",
      "description": "Approval line",
      "examples": ["Approved: Communications Director and General Counsel"],
      "x-translate": false
    }
  },
  "additionalProperties": false
}
