{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learner feedback form",
  "description": "A short form a learner fills in after a simulation or case study: ratings for the prebrief, realism, the debrief and learning, and open comments. Rating items use a 1 to 5 scale printed on the form.",
  "required": ["title", "items"],
  "properties": {
    "marking": {
      "type": "string",
      "description": "Exercise marking",
      "examples": ["EXERCISE \u00b7 LEARNER FEEDBACK"]
    },
    "title": {
      "type": "string",
      "description": "Case or scenario title",
      "examples": ["Deteriorating post-operative patient"]
    },
    "scale": {
      "type": "string",
      "description": "Rating scale text",
      "examples": ["1 = strongly disagree, 5 = strongly agree"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "Statements to rate",
      "items": {
        "type": "string",
        "description": "Statement",
        "examples": ["The prebrief prepared me for the case."]
      }
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 4,
      "description": "Open questions",
      "items": {
        "type": "string",
        "description": "Question",
        "examples": ["What is one thing you will do differently?"]
      }
    },
    "privacy": {
      "type": "string",
      "description": "Who can see the answers",
      "examples": [
        "Your instructor can see your answers. They are not shared outside your program."
      ]
    }
  },
  "type": "object",
  "additionalProperties": false
}
