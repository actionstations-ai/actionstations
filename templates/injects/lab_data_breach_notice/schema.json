{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research data breach notice",
  "description": "Notice of a research data incident to the IRB, a sponsor or study participants: what happened in plain terms, what data were involved, how many records, what the institution is doing and what the reader can do. The audience field sets the tone. Counts and dates must agree with the incident record.",
  "type": "object",
  "required": ["organization", "headline", "audience"],
  "properties": {
    "marking": {
      "type": "string",
      "description": "Exercise marking",
      "examples": ["EXERCISE · EXERCISE · EXERCISE"]
    },
    "organization": {
      "type": "string",
      "description": "Issuing organization",
      "examples": ["Marston State University (fictional)"],
      "x-translate": false
    },
    "division": {
      "type": "string",
      "description": "Office or unit",
      "examples": ["Office of Biosafety"],
      "x-translate": false
    },
    "headline": {
      "type": "string",
      "description": "Headline",
      "examples": ["Notice of a data incident affecting a research study"]
    },
    "audience": {
      "type": "string",
      "description": "Audience",
      "examples": ["Institutional review board"]
    },
    "from": {
      "type": "string",
      "description": "From",
      "examples": ["Office of Research Compliance, Marston State University"],
      "x-translate": false
    },
    "to": {
      "type": "string",
      "description": "To",
      "examples": ["Marston State University IRB"],
      "x-translate": false
    },
    "date": {
      "type": "string",
      "description": "Date",
      "examples": ["2026-10-24"],
      "x-translate": false
    },
    "studyTitle": {
      "type": "string",
      "description": "Study",
      "examples": ["Sleep and Memory in Adults (fictional)"],
      "x-translate": false
    },
    "protocolNumber": {
      "type": "string",
      "description": "Protocol number",
      "examples": ["IRB-2025-0388"],
      "x-translate": false
    },
    "discoveredAt": {
      "type": "string",
      "description": "Discovered",
      "examples": ["2026-10-22 07:10"],
      "x-translate": false
    },
    "recordsAffected": {
      "type": "string",
      "description": "Records affected",
      "examples": ["214 participants"],
      "x-translate": false
    },
    "notificationDeadline": {
      "type": "string",
      "description": "Notification deadline that applies",
      "examples": ["IRB policy: within 5 business days"],
      "x-translate": false
    },
    "whatHappened": {
      "type": "array",
      "maxItems": 6,
      "description": "What happened",
      "items": {
        "type": "string",
        "description": "Entry"
      },
      "examples": [
        [
          "Ransomware encrypted two instrument computers on the research network.",
          "Research IT isolated the network at 07:40 and began restoring from backup."
        ]
      ]
    },
    "dataInvolved": {
      "type": "array",
      "maxItems": 6,
      "description": "Data involved",
      "items": {
        "type": "string",
        "description": "Entry"
      },
      "examples": [
        [
          "Participant study identifiers and test scores.",
          "No names, addresses or payment data were stored on these computers."
        ]
      ]
    },
    "whatWeAreDoing": {
      "type": "array",
      "maxItems": 6,
      "description": "What the institution is doing",
      "items": {
        "type": "string",
        "description": "Entry"
      },
      "examples": [
        [
          "Restoring the computers from clean backups.",
          "Reviewing whether any data left the network."
        ]
      ]
    },
    "whatYouCanDo": {
      "type": "array",
      "maxItems": 5,
      "description": "What you can do",
      "items": {
        "type": "string",
        "description": "Entry"
      },
      "examples": [
        [
          "Contact the study team with questions.",
          "Report anything unusual about study messages to the IRB office."
        ]
      ]
    }
  }
}
