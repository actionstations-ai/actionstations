{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Humanitarian flash update",
  "description": "A short numbered update from a coordination office in the first days of a sudden-onset disaster: situation, humanitarian impact with each figure marked confirmed or estimate, response, gaps, access and a contact. Organizations and people are fictional.",
  "type": "object",
  "required": ["organization", "updateNumber", "title", "issued", "situation"],
  "properties": {
    "marking": {
      "type": "string",
      "description": "Exercise marking",
      "examples": ["EXERCISE · EXERCISE · EXERCISE"],
      "x-translate": false
    },
    "organization": {
      "type": "string",
      "description": "Issuing organization",
      "examples": ["Humanitarian Coordination Office, Republic of Tamsaria"],
      "x-translate": false
    },
    "unit": {
      "type": "string",
      "description": "Office, unit or team",
      "examples": ["Karun Province Sub-Office"],
      "x-translate": false
    },
    "updateNumber": {
      "type": "string",
      "description": "Update number",
      "examples": ["Flash Update No. 3"],
      "x-translate": false
    },
    "title": {
      "type": "string",
      "description": "Event title",
      "examples": ["Karun Province earthquake"]
    },
    "issued": {
      "type": "string",
      "description": "Date and time issued, with time zone",
      "examples": ["15 October 2026, 18:00 local (UTC+3)"],
      "x-translate": false
    },
    "situation": {
      "type": "string",
      "description": "What happened and what is known, including what is not yet known",
      "examples": [
        "A magnitude 6.8 earthquake struck Karun Province at 04:12 on 13 October. Aftershocks continue. The disaster management authority has declared a state of emergency in Karun North, Karun South, Bel Ravi, Soma Valley and Hadar districts. Communications are intermittent in Hadar."
      ]
    },
    "impact": {
      "type": "array",
      "description": "Humanitarian impact figures",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "One row",
        "properties": {
          "indicator": {
            "type": "string",
            "description": "What is counted",
            "examples": ["People affected"]
          },
          "value": {
            "type": "string",
            "description": "The figure",
            "examples": ["410,000"],
            "x-translate": false
          },
          "status": {
            "type": "string",
            "description": "Whether the figure is confirmed or an estimate",
            "enum": ["confirmed", "estimate"],
            "examples": ["estimate"]
          },
          "source": {
            "type": "string",
            "description": "Who reported it and when",
            "examples": ["Disaster management authority, 15 Oct"]
          }
        },
        "required": ["indicator", "value", "status"]
      },
      "examples": [
        [
          {
            "indicator": "People affected",
            "value": "410,000",
            "status": "estimate",
            "source": "Disaster management authority, 15 Oct"
          },
          {
            "indicator": "People killed",
            "value": "312",
            "status": "confirmed",
            "source": "Provincial health directorate, 15 Oct"
          },
          {
            "indicator": "People injured",
            "value": "1,940",
            "status": "estimate",
            "source": "Health partners, 15 Oct"
          },
          {
            "indicator": "Households displaced",
            "value": "38,000",
            "status": "estimate",
            "source": "Shelter partners, 15 Oct"
          },
          {
            "indicator": "Health facilities damaged (of 64 assessed)",
            "value": "17",
            "status": "confirmed",
            "source": "Rapid assessment, 15 Oct"
          }
        ]
      ]
    },
    "response": {
      "type": "string",
      "description": "What the government and humanitarian partners are doing",
      "examples": [
        "The government has requested international assistance for health, shelter and water. Eleven humanitarian organizations have reported activities in four of five affected districts. A Humanitarian Country Team meeting is held on 16 October to consider a request for cluster activation."
      ]
    },
    "gaps": {
      "type": "array",
      "description": "Gaps and constraints, each naming the area",
      "maxItems": 8,
      "items": {
        "type": "string",
        "description": "Entry"
      },
      "examples": [
        [
          "Hadar: no health partner has reported activity.",
          "Soma Valley: trauma surgery capacity is below need.",
          "Bel Ravi: no psychosocial support partner reported."
        ]
      ]
    },
    "access": {
      "type": "string",
      "description": "Access constraints",
      "examples": [
        "Route 4 is open to light vehicles only north of Bel Ravi after a landslide. Hadar is reachable by Route 9 in daylight. Customs clearance for relief items takes up to 48 hours at the airport."
      ]
    },
    "nextUpdate": {
      "type": "string",
      "description": "When the next update will be issued",
      "examples": ["16 October 2026, 18:00 local"],
      "x-translate": false
    },
    "contact": {
      "type": "string",
      "description": "Contact for this update (fictional)",
      "examples": ["Information Management Officer, ocha-karun@tamsaria-hc.example"],
      "x-translate": false
    }
  },
  "additionalProperties": false
}
