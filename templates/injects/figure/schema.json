{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figure",
  "type": "object",
  "required": ["figures"],
  "properties": {
    "heading": {
      "type": "string",
      "description": "Heading above the figure"
    },
    "source": {
      "type": "string",
      "description": "Where the numbers come from, for example 'Plant historian, 14:00 to 16:00'"
    },
    "hideTable": {
      "type": "boolean",
      "description": "Leave out the data table beside the figure"
    },
    "figures": {
      "type": "object",
      "description": "The figure to draw, as { main: { kind, data } }. Kinds: time_series, bar, stacked_bar, gauge, status_board, table, annotated_timeline, hydrograph, flood_gauge_summary, river_profile, rain_stage, triage_counts, patient_tracking_board, hospital_capacity_board, protective_action_zone, justice_unit_status, justice_incident_timeline, justice_jail_population, justice_court_continuity, justice_court_recovery, justice_filings_backlog, animal_premises_map, animal_premises_table, animal_movement_map, animal_depop_tracker, animal_sampling_schedule, animal_inundation_overlay, gov_bia_table, gov_recovery_tracker, gov_decision_timeline, wildfire_fire_map, wildfire_evacuation_board, wildfire_psps_board, wildfire_aqi_series, wildfire_smoke_map, hosp_outbreak_curve, hosp_muster_board, hosp_floor_status, hosp_departures_timeline, hosp_port_board.",
      "required": ["main"],
      "properties": {
        "main": {
          "type": "object",
          "required": ["kind", "data"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "time_series",
                "bar",
                "stacked_bar",
                "gauge",
                "status_board",
                "table",
                "annotated_timeline",
                "hydrograph",
                "flood_gauge_summary",
                "river_profile",
                "rain_stage",
                "triage_counts",
                "patient_tracking_board",
                "hospital_capacity_board",
                "protective_action_zone",
                "justice_unit_status",
                "justice_incident_timeline",
                "justice_jail_population",
                "justice_court_continuity",
                "justice_court_recovery",
                "justice_filings_backlog",
                "animal_premises_map",
                "animal_premises_table",
                "animal_movement_map",
                "animal_depop_tracker",
                "animal_sampling_schedule",
                "animal_inundation_overlay",
                "gov_bia_table",
                "gov_recovery_tracker",
                "gov_decision_timeline",
                "hs_contact_series",
                "hs_queue_board",
                "hs_staffing_coverage",
                "hs_shelter_dashboard",
                "hs_shelter_map",
                "hs_reunification_flow",
                "hs_displaced_tracker",
                "wildfire_fire_map",
                "wildfire_evacuation_board",
                "wildfire_psps_board",
                "wildfire_aqi_series",
                "wildfire_smoke_map",
                "hosp_outbreak_curve",
                "hosp_muster_board",
                "hosp_floor_status",
                "hosp_departures_timeline",
                "hosp_port_board"
              ]
            },
            "data": {
              "type": "object",
              "description": "Data for the kind (docs/guides/templates.md, Figures)"
            },
            "options": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
