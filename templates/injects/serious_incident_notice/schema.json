{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Serious incident notification (draft)",
  "description": "Draft notification of a serious incident of an AI system to a market surveillance authority, with the fields the draft EU template names: the system, the date of awareness, the causal link assessment, the harm and the status, and a field for parallel sectoral reports. A draft for the exercise, not a filing. The clock stated must match the scenario configuration.",
  "type": "object",
  "required": [
    "authority",
    "reportType",
    "provider",
    "system",
    "awarenessDate",
    "description",
    "harm",
    "causalLink",
    "status"
  ],
  "properties": {
    "marking": {
      "type": "string",
      "description": "Exercise marking",
      "examples": ["EXERCISE · EXERCISE · EXERCISE"],
      "x-translate": false
    },
    "authority": {
      "type": "string",
      "description": "Authority addressed (fictional)",
      "examples": [
        "Financial Supervisory Authority of Northmark (market surveillance authority for AI used by financial institutions)"
      ],
      "x-translate": false
    },
    "reportType": {
      "type": "string",
      "description": "Report type",
      "examples": ["Initial report (incomplete)"],
      "enum": ["Initial report (incomplete)", "Intermediate report", "Final report"]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provider",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name",
          "examples": ["Northgate Models Ltd (fictional)"],
          "x-translate": false
        },
        "contact": {
          "type": "string",
          "description": "Contact",
          "examples": ["compliance@northgate.example"],
          "x-translate": false
        }
      },
      "required": ["name"]
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "description": "System",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name",
          "examples": ["Harbor Credit Assess"],
          "x-translate": false
        },
        "version": {
          "type": "string",
          "description": "Version",
          "examples": ["model 4.2"],
          "x-translate": false
        },
        "intendedPurpose": {
          "type": "string",
          "description": "Intended purpose",
          "examples": [
            "Evaluates the creditworthiness of consumer loan applicants (high-risk use, AI Act Annex III, point 5(b))"
          ]
        }
      },
      "required": ["name"]
    },
    "incidentDate": {
      "type": "string",
      "description": "Date of the incident",
      "examples": ["February 2 to February 9, 2028"],
      "x-translate": false
    },
    "awarenessDate": {
      "type": "string",
      "description": "Date the provider became aware",
      "examples": ["February 9, 2028"],
      "x-translate": false
    },
    "description": {
      "type": "string",
      "description": "What happened",
      "examples": [
        "After a data update on February 2, the system scored applicants from two postal areas markedly lower than comparable applicants elsewhere, and their applications were declined."
      ]
    },
    "harm": {
      "type": "string",
      "description": "Harm",
      "examples": [
        "214 applicants were declined on the affected scores; possible infringement of obligations under Union law intended to protect fundamental rights (non-discrimination). No death or harm to health."
      ]
    },
    "category": {
      "type": "string",
      "description": "Category of serious incident",
      "examples": ["Infringement of fundamental rights obligations"],
      "enum": [
        "Death",
        "Serious harm to health",
        "Critical infrastructure disruption",
        "Infringement of fundamental rights obligations",
        "Serious harm to property or the environment",
        "Widespread infringement",
        "Under assessment"
      ]
    },
    "causalLink": {
      "type": "object",
      "additionalProperties": false,
      "description": "Causal link assessment",
      "properties": {
        "assessment": {
          "type": "string",
          "description": "Assessment",
          "examples": ["Reasonably likely"],
          "enum": ["Established", "Reasonably likely", "Not established", "Under investigation"]
        },
        "basis": {
          "type": "string",
          "description": "Basis",
          "examples": [
            "Score logs show the shift in each affected decision; the data update on February 2 is the only change in the period."
          ]
        }
      },
      "required": ["assessment", "basis"]
    },
    "parallelReports": {
      "type": "string",
      "description": "Parallel sectoral reports",
      "examples": ["National equality body informed on February 10."]
    },
    "correctiveActions": {
      "type": "array",
      "description": "Corrective actions",
      "maxItems": 8,
      "items": {
        "type": "string",
        "description": "Entry"
      },
      "examples": [
        [
          "Scores from the February 2 update withdrawn on February 9; the earlier version restored",
          "Declined applications from the period queued for human review"
        ]
      ]
    },
    "clockStated": {
      "type": "string",
      "description": "Deadline stated, from the scenario configuration",
      "examples": ["15 days after awareness (scenario clock: EU AI Act Article 73)"],
      "x-translate": false
    },
    "status": {
      "type": "string",
      "description": "Status of the investigation",
      "examples": ["Investigation open; report will be updated"]
    },
    "contact": {
      "type": "string",
      "description": "Contact",
      "examples": ["Compliance officer: Mara Venn, +00 555 0100"],
      "x-translate": false
    }
  },
  "additionalProperties": false
}
