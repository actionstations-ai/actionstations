{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAP alert (IPAWS)",
  "description": "A Common Alerting Protocol 1.2 alert as an alert-origination tool shows it before Send (variant review) or as CAP XML (variant xml). Always an exercise message: status is Exercise or Test, never Actual. WEA texts are limited to 90 and 360 characters. Sender, places and codes are simulated or real geography; never a real alert.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identifier",
    "sender",
    "senderName",
    "status",
    "msgType",
    "sent",
    "expires",
    "category",
    "event",
    "urgency",
    "severity",
    "certainty",
    "eventCode",
    "easOrg",
    "areaDesc",
    "sameCodes",
    "headline",
    "description",
    "instruction",
    "cmamText"
  ],
  "properties": {
    "identifier": {
      "type": "string",
      "description": "Unique alert id",
      "maxLength": 120,
      "examples": ["EXERCISE-RCEM-2026-0042"],
      "x-translate": false
    },
    "sender": {
      "type": "string",
      "description": "Sender id, usually an e-mail style address of the alerting authority",
      "maxLength": 120,
      "examples": ["alerts@rookcounty-em.example"],
      "x-translate": false
    },
    "senderName": {
      "type": "string",
      "description": "Name of the sending authority",
      "maxLength": 120,
      "examples": ["Rook County Emergency Management"],
      "x-translate": false
    },
    "status": {
      "type": "string",
      "description": "Exercise or Test; Actual is not allowed",
      "enum": ["Exercise", "Test"],
      "examples": ["Exercise"]
    },
    "msgType": {
      "type": "string",
      "description": "Alert, Update or Cancel",
      "enum": ["Alert", "Update", "Cancel"],
      "examples": ["Alert"]
    },
    "references": {
      "type": "string",
      "description": "For Update and Cancel: \"sender,identifier,sent\" of the alert it changes",
      "maxLength": 300,
      "examples": [
        "alerts@rookcounty-em.example,EXERCISE-RCEM-2026-0041,2026-10-21T13:40:00-04:00"
      ],
      "x-translate": false
    },
    "sent": {
      "type": "string",
      "description": "When the alert was sent. Date and time with a UTC offset, e.g. 2026-10-21T14:14:00-04:00 (never Z)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$",
      "examples": ["2026-10-21T14:14:00-04:00"]
    },
    "effective": {
      "type": "string",
      "description": "When it takes effect (defaults to sent). Date and time with a UTC offset, e.g. 2026-10-21T14:14:00-04:00 (never Z)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$",
      "examples": ["2026-10-21T14:14:00-04:00"]
    },
    "expires": {
      "type": "string",
      "description": "When it expires. Date and time with a UTC offset, e.g. 2026-10-21T14:14:00-04:00 (never Z)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$",
      "examples": ["2026-10-21T17:15:00-04:00"]
    },
    "category": {
      "type": "string",
      "description": "CAP category",
      "enum": [
        "Geo",
        "Met",
        "Safety",
        "Security",
        "Rescue",
        "Fire",
        "Health",
        "Env",
        "Transport",
        "Infra",
        "CBRNE",
        "Other"
      ],
      "examples": ["Met"]
    },
    "event": {
      "type": "string",
      "description": "Event type in words",
      "maxLength": 120,
      "examples": ["Flash Flood Warning"]
    },
    "responseType": {
      "type": "array",
      "description": "Recommended responses",
      "maxItems": 3,
      "items": {
        "type": "string",
        "description": "Response type",
        "enum": [
          "Shelter",
          "Evacuate",
          "Prepare",
          "Execute",
          "Avoid",
          "Monitor",
          "Assess",
          "AllClear",
          "None"
        ],
        "examples": ["Avoid"]
      },
      "examples": [["Avoid"]]
    },
    "urgency": {
      "type": "string",
      "description": "Urgency",
      "enum": ["Immediate", "Expected", "Future", "Past", "Unknown"],
      "examples": ["Immediate"]
    },
    "severity": {
      "type": "string",
      "description": "Severity",
      "enum": ["Extreme", "Severe", "Moderate", "Minor", "Unknown"],
      "examples": ["Severe"]
    },
    "certainty": {
      "type": "string",
      "description": "Certainty",
      "enum": ["Observed", "Likely", "Possible", "Unlikely", "Unknown"],
      "examples": ["Observed"]
    },
    "eventCode": {
      "type": "string",
      "description": "SAME event code (47 CFR 11.31(e))",
      "enum": [
        "ADR",
        "AVA",
        "AVW",
        "BZW",
        "CAE",
        "CDW",
        "CEM",
        "CFA",
        "CFW",
        "DMO",
        "DSW",
        "EAN",
        "EQW",
        "EVI",
        "EWW",
        "FFA",
        "FFS",
        "FFW",
        "FLA",
        "FLS",
        "FLW",
        "FRW",
        "HLS",
        "HMW",
        "HUA",
        "HUW",
        "HWA",
        "HWW",
        "LAE",
        "LEW",
        "NMN",
        "NPT",
        "NUW",
        "RHW",
        "RMT",
        "RWT",
        "SMW",
        "SPS",
        "SPW",
        "SQW",
        "SSA",
        "SSW",
        "SVA",
        "SVR",
        "SVS",
        "TOA",
        "TOE",
        "TOR",
        "TRA",
        "TRW",
        "TSA",
        "TSW",
        "VOW",
        "WSA",
        "WSW"
      ],
      "examples": ["FFW"]
    },
    "easOrg": {
      "type": "string",
      "description": "EAS-ORG parameter: who originates (CIV for civil authorities)",
      "enum": ["CIV", "WXR", "EAS", "PEP"],
      "examples": ["CIV"]
    },
    "channels": {
      "type": "array",
      "description": "IPAWS channels selected",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Channel",
        "enum": ["EAS", "WEA", "NWEM"],
        "examples": ["WEA"]
      },
      "examples": [["EAS", "WEA"]]
    },
    "areaDesc": {
      "type": "string",
      "description": "Affected area in words",
      "maxLength": 300,
      "examples": ["Haldane County, OH; Marlow County, OH"]
    },
    "sameCodes": {
      "type": "array",
      "description": "SAME location codes PSSCCC (P part of county, SS state FIPS, CCC county FIPS), up to 31",
      "minItems": 1,
      "maxItems": 31,
      "items": {
        "type": "string",
        "description": "Six-digit SAME code",
        "pattern": "^[0-9]{6}$",
        "examples": ["039035"]
      },
      "examples": [["039035", "039093"]]
    },
    "headline": {
      "type": "string",
      "description": "Short headline (the tool adds the word EXERCISE if missing)",
      "maxLength": 160,
      "examples": ["Flash Flood Warning for Haldane and Marlow Counties until 5:15 PM"]
    },
    "description": {
      "type": "string",
      "description": "What is happening, where and why",
      "examples": [
        "At 2:13 PM EDT, radar and rain gauges show thunderstorms producing heavy rain. Flash flooding is ongoing or expected to begin shortly. Cedar Ridge Reservoir is near its spillway crest."
      ]
    },
    "instruction": {
      "type": "string",
      "description": "What people should do",
      "examples": [
        "Move to higher ground now. Turn around, do not drown: do not drive through flooded roads."
      ]
    },
    "cmamText": {
      "type": "string",
      "description": "WEA text, at most 90 characters",
      "maxLength": 90,
      "examples": [
        "EXERCISE Flash Flood Warning in your area until 5:15 PM. Move to higher ground. -RCEM"
      ]
    },
    "cmamLongText": {
      "type": "string",
      "description": "WEA long text, at most 360 characters",
      "maxLength": 360,
      "examples": [
        "EXERCISE Flash Flood Warning for Haldane and Marlow Counties until 5:15 PM EDT. Flooding is ongoing near Cedar Ridge Reservoir. Move to higher ground now and do not drive through flooded roads. Rook County Emergency Management."
      ]
    },
    "infoEs": {
      "type": "object",
      "description": "Optional Spanish (es-US) info block, as IPAWS sends for Spanish WEA",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string",
          "description": "Spanish headline",
          "maxLength": 160,
          "examples": ["Advertencia de inundacion repentina"],
          "x-translate": false
        },
        "description": {
          "type": "string",
          "description": "Spanish description",
          "x-translate": false
        },
        "instruction": {
          "type": "string",
          "description": "Spanish instruction",
          "x-translate": false
        },
        "cmamText": {
          "type": "string",
          "description": "Spanish WEA text, at most 90 characters",
          "maxLength": 90,
          "x-translate": false
        },
        "cmamLongText": {
          "type": "string",
          "description": "Spanish WEA text, at most 360 characters",
          "maxLength": 360,
          "x-translate": false
        }
      }
    }
  }
}
