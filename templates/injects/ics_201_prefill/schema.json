{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICS 201 Incident Briefing",
  "description": "FEMA ICS Form 201 (four pages: header blocks 1-3, map/sketch, situation and safety summary, objectives, actions, current organization, resource summary). Every field is optional: the 'blank' variant prints empty boxes for the player briefing packet; the default variant shows the values as typed entries.",
  "type": "object",
  "properties": {
    "incidentName": {
      "type": "string",
      "description": "Block 1. Short incident name",
      "examples": ["NCIA FIDS / AODB Data Integrity Incident"]
    },
    "incidentNumber": {
      "type": "string",
      "description": "Block 2. Incident number assigned by the agency",
      "examples": ["NCIA-2026-0417"]
    },
    "dateInitiated": {
      "type": "string",
      "description": "Block 3. Date the form was started, MM/DD/YYYY",
      "examples": ["05/22/2026"]
    },
    "timeInitiated": {
      "type": "string",
      "description": "Block 3. Time the form was started, 24-hour clock",
      "examples": ["0945"]
    },
    "mapNotes": {
      "type": "array",
      "description": "Block 4. Typed key for the map/sketch area (affected gates, areas, staging points). The rest of the box is left blank for a hand sketch.",
      "items": { "type": "string", "examples": ["Gate B4: wrong destination on gate screen"] }
    },
    "situationSummary": {
      "type": "string",
      "description": "Block 5. What is known, what is broken, current impact (3-6 sentences)",
      "examples": [
        "Since 0900, FIDS screens in Concourses A and B show incorrect destinations and gates."
      ]
    },
    "safetyBriefing": {
      "type": "string",
      "description": "Block 5. Health and safety hazards and protective measures",
      "examples": ["Crowding at counters and the checkpoint; watch for crush risk at gates."]
    },
    "objectives": {
      "type": "array",
      "description": "Block 7. Current and planned objectives (3-6, imperative)",
      "items": {
        "type": "string",
        "examples": ["Keep passengers safe and moving with accurate gate information"]
      }
    },
    "actions": {
      "type": "array",
      "description": "Block 8. Current and planned actions, strategies and tactics in time order",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "time": {
            "type": "string",
            "description": "24-hour time the action happened or is planned",
            "examples": ["0915"]
          },
          "action": {
            "type": "string",
            "description": "One line describing the action",
            "examples": ["IT opens ticket on Gate B4 display; confirms AODB is the source"]
          }
        }
      }
    },
    "orgChart": {
      "type": "object",
      "description": "Block 9. Current organization: names in each position (add agency in parentheses where useful)",
      "additionalProperties": false,
      "properties": {
        "incidentCommanders": {
          "type": "array",
          "description": "Incident Commander, or up to 3 for Unified Command",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "description": "Name", "examples": ["R. Delgado"] },
              "agency": {
                "type": "string",
                "description": "Agency or role",
                "examples": ["NCIA Ops Director"]
              }
            }
          }
        },
        "publicInformationOfficer": {
          "type": "string",
          "description": "Public Information Officer",
          "examples": ["T. Nguyen"]
        },
        "safetyOfficer": {
          "type": "string",
          "description": "Safety Officer",
          "examples": ["K. Osei"]
        },
        "liaisonOfficer": {
          "type": "string",
          "description": "Liaison Officer",
          "examples": ["M. Brandt (Airline Liaison)"]
        },
        "operationsChief": {
          "type": "string",
          "description": "Operations Section Chief",
          "examples": ["D. Kowalski"]
        },
        "planningChief": {
          "type": "string",
          "description": "Planning Section Chief",
          "examples": ["A. Patel"]
        },
        "logisticsChief": {
          "type": "string",
          "description": "Logistics Section Chief",
          "examples": ["J. Romero"]
        },
        "financeChief": {
          "type": "string",
          "description": "Finance/Administration Section Chief",
          "examples": ["Not activated"]
        },
        "operationsUnits": { "$ref": "#/$defs/units" },
        "planningUnits": { "$ref": "#/$defs/units" },
        "logisticsUnits": { "$ref": "#/$defs/units" },
        "financeUnits": { "$ref": "#/$defs/units" }
      }
    },
    "resources": {
      "type": "array",
      "description": "Block 10. Resource summary rows",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource"],
        "properties": {
          "resource": {
            "type": "string",
            "description": "Number and kind/type of resource",
            "examples": ["Whiteboard teams (x6)"]
          },
          "identifier": {
            "type": "string",
            "description": "Agency or resource designator",
            "examples": ["NCIA-OPS-WB"]
          },
          "ordered": {
            "type": "string",
            "description": "Date/time ordered",
            "examples": ["05/22 1010"]
          },
          "eta": { "type": "string", "description": "Estimated arrival", "examples": ["1030"] },
          "arrived": {
            "type": "boolean",
            "description": "True once the resource has arrived (prints a check mark)"
          },
          "notes": {
            "type": "string",
            "description": "Location, assignment or status",
            "examples": ["Staged at atrium; deploy on FIDS shutdown"]
          }
        }
      }
    },
    "preparedBy": {
      "type": "object",
      "description": "Block 6. Who prepared the form (repeated on every page)",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Name", "examples": ["R. Delgado"] },
        "position": {
          "type": "string",
          "description": "Position/Title",
          "examples": ["Incident Commander"]
        },
        "signature": {
          "type": "string",
          "description": "Name as it should appear signed (rendered in handwriting)",
          "examples": ["R. Delgado"]
        },
        "dateTime": {
          "type": "string",
          "description": "Date/time prepared",
          "examples": ["05/22/2026 1045"]
        }
      }
    }
  },
  "$defs": {
    "units": {
      "type": "array",
      "description": "Up to 5 additional boxes under the section (branches, divisions, groups, units)",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Position or unit title",
            "examples": ["Terminal Branch Director"]
          },
          "name": { "type": "string", "description": "Person assigned", "examples": ["S. Mills"] }
        }
      }
    }
  },
  "additionalProperties": false
}
