{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" },
    "_meta": { "title": "Load SDXL base" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1216, "height": 832, "batch_size": 1 },
    "_meta": { "title": "Image size" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "documentary photograph", "clip": ["4", 1] },
    "_meta": { "title": "Positive prompt" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "illustration, painting, cartoon, 3d render, cgi, oversaturated, watermark, logo, blurry, deformed hands, extra fingers",
      "clip": ["4", 1]
    },
    "_meta": { "title": "Negative prompt" }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 25,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    },
    "_meta": { "title": "Sampler" }
  },
  "10": {
    "class_type": "EmptyImage",
    "inputs": { "width": 1216, "height": 832, "batch_size": 1, "color": 4210752 },
    "_meta": { "title": "Dark start image (lighting: dark)" }
  },
  "11": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["10", 0], "vae": ["4", 2] },
    "_meta": { "title": "Dark start latent (lighting: dark)" }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "dark unlit ceiling in deep shadow, black, power outage",
      "clip": ["4", 1]
    },
    "_meta": { "title": "Dark ceiling prompt (lighting: dark)" }
  },
  "13": {
    "class_type": "ConditioningSetAreaPercentage",
    "inputs": {
      "conditioning": ["12", 0],
      "width": 1,
      "height": 0.4,
      "x": 0,
      "y": 0,
      "strength": 1
    },
    "_meta": { "title": "Dark ceiling area, top 40% (lighting: dark)" }
  },
  "14": {
    "class_type": "ConditioningCombine",
    "inputs": { "conditioning_1": ["6", 0], "conditioning_2": ["13", 0] },
    "_meta": { "title": "Positive + dark ceiling (lighting: dark)" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] },
    "_meta": { "title": "Decode" }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "ttx/sdxl-photo", "images": ["8", 0] },
    "_meta": { "title": "Save" }
  }
}
