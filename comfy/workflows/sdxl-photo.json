{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" },
    "_meta": { "title": "Load SDXL base" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1216, "height": 832, "batch_size": 1 },
    "_meta": { "title": "Image size" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "documentary photograph", "clip": ["4", 1] },
    "_meta": { "title": "Positive prompt" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "illustration, painting, cartoon, 3d render, cgi, oversaturated, watermark, logo, blurry, deformed hands, extra fingers",
      "clip": ["4", 1]
    },
    "_meta": { "title": "Negative prompt" }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 25,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    },
    "_meta": { "title": "Sampler" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] },
    "_meta": { "title": "Decode" }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "ttx/sdxl-photo", "images": ["8", 0] },
    "_meta": { "title": "Save" }
  }
}
