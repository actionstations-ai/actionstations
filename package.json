{
  "name": "actionstations",
  "productName": "Action Stations",
  "version": "0.5.1",
  "description": "Local-first desktop app that turns an organization's plans into complete, exportable tabletop exercises.",
  "author": "Matt Crowley",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build:app": "electron-vite build && pnpm build:player",
    "build": "electron-vite build && pnpm build:player && node scripts/build-bundled-packs.mjs && electron-builder",
    "build:check": "electron-vite build && pnpm build:player && node scripts/build-bundled-packs.mjs && electron-builder --dir",
    "build:packs": "node scripts/build-bundled-packs.mjs",
    "build:player": "vite build -c vite.player.config.ts && node scripts/check-player-bundle.mjs",
    "dev:player": "node scripts/player-dev.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "icons": "electron build/make-icons.mjs",
    "release": "bash scripts/release.sh",
    "lint": "eslint . --max-warnings=0",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/vitest-electron.mjs run",
    "test:watch": "node scripts/vitest-electron.mjs",
    "test:templates": "node scripts/test-templates.mjs",
    "e2e": "electron-vite build && pnpm build:player && playwright test",
    "ci:local": "bash scripts/local-ci.sh",
    "badges": "BADGES=1 bash scripts/local-ci.sh",
    "stats": "node scripts/repo-stats.mjs",
    "bench": "node scripts/bench/run.mjs",
    "bench:report": "node scripts/bench/report.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@csstools/css-tokenizer": "4.0.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "^4.3.1",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@peculiar/x509": "^1.14.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "ajv": "^8.20.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "diff": "^9.0.0",
    "docx": "^9.13.0",
    "dompurify": "^3.4.17",
    "eventsource-parser": "^4.1.2",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.10",
    "js-yaml": "^5.5.0",
    "jszip": "^3.10.2",
    "lamejs": "^1.2.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "p-queue": "^10.0.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "^6.4.299",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^7.0.0",
    "ulid": "^3.0.2",
    "wavefile": "^11.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "clsx": "^2.1.1",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "pixelmatch": "^8.0.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}
