{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticketNo", "priority", "subject", "description"],
  "properties": {
    "ticketNo": {
      "type": "string",
      "description": "Ticket number",
      "examples": ["4492"]
    },
    "priority": {
      "type": "string",
      "enum": ["Low", "Medium", "High", "Critical"]
    },
    "requester": {
      "type": "string",
      "description": "Who opened it"
    },
    "subject": {
      "type": "string",
      "description": "Subject"
    },
    "description": {
      "type": "string",
      "description": "Body"
    },
    "status": {
      "type": "string",
      "description": "Status"
    },
    "assignee": {
      "type": "string",
      "description": "Queue"
    }
  }
}
