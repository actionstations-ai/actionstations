  "subtitle": "Scenario 3: Data Integrity & FIDS",
  "version": 1,
  "status": "ready",
  "createdAt": "2026-10-21T00:00:00.000Z",
  "updatedAt": "2026-10-22T01:01:33.234Z",
  "brief": {
    "userPrompt": "A malicious actor manipulates the AODB so FIDS, BHS and PA mislead passengers; test data integrity, public trust and crowd management.",
    "audience": [
      "Airport Operations",
      "IT/Cybersecurity",
      "Public Safety",
      "Public Information (PIO)"
    ],
    "durationHours": 4,
    "phaseCount": 4,
    "learningObjectives": [
      "Coordinate public messaging across IT, Ops, and PIO during a reputational crisis",
      "Make high-consequence operational decisions on incomplete or conflicting technical data",
      "Identify the root cause using provided logs"
    ],
    "constraints": ["must test TIRP §1.4.5, §4 and §13.6"],
    "startWallClock": "09:00"
  },
  "overview": {
    "theme": "Data Integrity, Public Trust, and Crowd Management.",
    "threat": "A malicious actor has gained access to the airport's \"Airport Operational Database\" (AODB), which feeds data to the Flight Information Display Systems (FIDS), Baggage Handling System (BHS), and the automated Public Address (PA) system.",
    "operationalImpact": "Passengers are misinformed, directed to the wrong gates, or told their flights are cancelled when they aren't. This causes crowding, missed flights, and potential safety hazards.",
    "coreSectionsTested": [
      {
        "documentId": "tirp",
        "documentTitle": "Terminal Incident Response Plan",
        "headingPath": "TIRP › Section 1 › 1.4 Guidance Applicable for All Incident Plans › 1.4.5 Use of Communication Systems",
        "quote": "Communication Systems (Using alternative methods)."
      },
      {
        "documentId": "tirp",
        "documentTitle": "Terminal Incident Response Plan",
        "headingPath": "TIRP › Section 4: Repopulation",
        "quote": "Repopulation (Managing passenger flow)."
      },
      {
        "documentId": "tirp",
        "documentTitle": "Terminal Incident Response Plan",
        "headingPath": "TIRP › Section 13 › 13.6 Scenario C: FIDS / BHS System Failure",
        "quote": "FIDS / BHS System Failure (Technical response)."
      }
    ],
    "targetAudience": "Airport Operations, IT/Cybersecurity, Public Safety, Public Information (PIO).",
    "location": "North Coast International Airport (NCIA)"
  },
  "objectives": [
    {
      "id": "obj-communication",
      "name": "Communication",
      "text": "Demonstrate the ability to coordinate public messaging across IT, Ops, and PIO functions during a reputational crisis."
    },
    {
      "id": "obj-decision",
      "name": "Decision Making",
      "text": "Demonstrate the ability to make high-consequence operational decisions (e.g., \"Go Dark\") based on incomplete or conflicting technical data."
    },
    {
      "id": "obj-technical",
      "name": "Technical Analysis",
      "text": "Correctly identify the root cause (SQL Injection / Compromised Credential) using provided logs."
    }
  ],
