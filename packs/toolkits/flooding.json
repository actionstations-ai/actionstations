  "knowledge": {
    "glossary": [
      {
        "term": "Stage",
        "definition": "River height in feet above the gauge datum, which is not elevation above sea level."
      },
      {
        "term": "Action stage",
        "definition": "The stage at which agencies begin to prepare or act; below flood stage."
      },
      {
        "term": "Flood stage",
        "definition": "The stage at which flooding begins to cause damage or a threat; it is set per gauge and is not the same as bankfull."
      },
      {
        "term": "Flood categories",
        "definition": "Minor, moderate and major flooding, set per forecast point from local impacts; a point may have no minor, moderate or major category (a leveed point may first see impacts at moderate)."
      },
      {
        "term": "Crest",
        "definition": "The highest stage of a flood at a point, with a time; the forecast crest is revised with each forecast."
      },
      {
        "term": "Flash flood warning tags",
        "definition": "Base (no tag), CONSIDERABLE for urgent action, CATASTROPHIC only with flash flood emergency language; Wireless Emergency Alerts go out only for CONSIDERABLE and CATASTROPHIC."
      }
    ],
    "productConventions": [
      "Stage is in feet with the gauge location named; flow is in cfs or kcfs; times are local with the gauge's time zone.",
      "A forecast has an issuance time and a forecast crest with a time; revised forecasts say what changed since the last issuance.",
      "NWS products follow Ready, Set, Go: outlook days ahead, watch when flooding is possible, warning when it is occurring or imminent, then statements.",
      "A flood warning names the river point, the category, the forecast crest and the impacts at that stage.",
      "A closure notice names the road, the status, the stage at which it floods and the time of the status.",
      "Use field_report for a levee patrol report and ics_213_general_message for a flood fight request.",
      "Evaluation guide tasks: warning messages match the forecast category (Public Information and Warning); decisions rest on the latest forecast issuance (Situational Assessment); roads closed before they flood (Critical Transportation); shelters sized for pets and access needs (Mass Care); pump stations and plants protected (Infrastructure Systems); sandbags delivered before action stage (Logistics)."
    ],
    "realismRules": [
      "Never claim a stage is minor, moderate or major unless the point's own category table says so; the same crest is moderate on one river and minor on another.",
      "Do not use flood stage and bankfull as the same thing.",
      "A CATASTROPHIC tag appears only with flash flood emergency language, and a WEA is not sent for a base-tag warning.",
      "River forecasts change; a decision should name the forecast issuance it rests on, and a stale forecast is a common injection.",
      "Flash floods rise in minutes to hours; river floods rise over days and give time to sandbag, close roads and evacuate.",
      "Tie each closure, evacuation and sandbag action to a stage or a clearance time, not to the clock alone.",
      "A gauge can fail, ice up or be washed out during the event; missing data is not zero.",
      "Real past events are historical and dated; fictional events use invented gauges and places, never a real person or private business."
    ]
  },
  "lintRules": ["flood_categories", "flash_flood_tags", "flood_product_order", "stage_units"]
