  "capabilities": [
    {
      "coreCapability": "public_information_and_warning",
      "criticalTasks": [
        "Impact-focused messages state effects and actions, not solar physics",
        "Messages from the utility, airline, telecom and emergency management agree on level and duration",
        "The public is told what a long or wide outage would mean before it begins"
      ]
    },
    {
      "coreCapability": "situational_assessment",
      "criticalTasks": [
        "Decisions rest on the latest SWPC product and name which message or reading they use",
        "Players tell a failed data feed from a quiet Sun",
        "The uncertainty of CME arrival time is carried into decisions"
      ]
    },
    {
      "coreCapability": "operational_communications",
      "criticalTasks": [
        "Forecast and current space weather information reaches every entity named in the plan, with times logged",
        "Backup communications are used when HF is lost"
      ]
    },
    {
      "coreCapability": "operational_coordination",
      "criticalTasks": [
        "The reliability coordinator and transmission operators coordinate actions across the wide area",
        "The procedure is applied at its predetermined condition and ended at its termination condition"
      ]
    },
    {
      "coreCapability": "infrastructure_systems",
      "criticalTasks": [
        "Time source failover happens before holdover expires",
        "Satellites are protected before the flux threshold",
        "GNSS-dependent operations stop and resume on stated accuracy"
      ]
    },
    {
      "coreCapability": "planning",
      "criticalTasks": [
        "The operating plan and procedure are followed and compared with the record afterward",
        "Follow-up items from the post-event review have owners and dates"
      ]
    }
  ],
