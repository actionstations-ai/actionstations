  "knowledge": {
    "glossary": [
      {
        "term": "G, S and R scales",
        "definition": "NOAA levels 1 to 5 (Minor to Extreme) for geomagnetic storms (Kp), solar radiation storms (10 MeV proton flux) and radio blackouts (X-ray class)."
      },
      {
        "term": "G to Kp",
        "definition": "G1 is Kp 5, G2 is 6, G3 is 7, G4 is 8 (including 9-), G5 is 9."
      },
      {
        "term": "R to X-ray class",
        "definition": "R1 is M1, R2 is M5, R3 is X1, R4 is X10, R5 is X20."
      },
      {
        "term": "S levels",
        "definition": "S1 is 10 particle flux units at 10 MeV and above; each level is ten times the one before."
      },
      {
        "term": "Watch, warning, alert",
        "definition": "A watch is elevated risk with uncertain timing; a warning is an event occurring, imminent or likely; an alert says a threshold has been crossed."
      },
      {
        "term": "GIC",
        "definition": "Geomagnetically induced current in a transformer neutral, driven by the geoelectric field in V/km."
      }
    ],
    "productConventions": [
      "SWPC products carry a message code (for example WATA20, WARK05, ALTK06, SUMX01) and serial number, and times are UTC.",
      "A geomagnetic storm watch lists the highest level predicted for each day; copy real layouts, not invented thresholds.",
      "Grid procedure notices follow NERC EOP-010: information received, actions at predetermined conditions, a termination condition, and evidence in logs.",
      "Impact messages state effects and actions, not solar physics; partner messages agree on severity and duration.",
      "Exercise products are marked as exercises; a simulated level is never presented as an NOAA product."
    ],
    "realismRules": [
      "Scale levels describe potential effects; impacts are regional and depend on latitude and ground conductivity.",
      "CME arrival time is uncertain by hours; state the lead time the scenario assumes.",
      "A flare gives minutes of effect and no lead time; radiation lasts hours to days; scintillation can last days after the peak.",
      "Satellite navigation is degraded for hours at G4 and days at G5; HF is intermittent at G3 and may be lost for a day or two at G5.",
      "Do not give engineering advice about protection settings or radiation doses.",
      "Real storms are historical and dated; fictional events use invented utilities, satellites and places."
    ]
  },
