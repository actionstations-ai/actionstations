// Corrective actions (FR-4 to FR-7, FR-13): one JSON file per action under corrective-actions/.
// A save carries the revision of the file it was edited from; if the file changed on disk since,
// the save is refused with CONFLICT and the other version, so two people never overwrite each other.
import { promises as fs } from 'node:fs'
import { resolve } from 'node:path'
import {
  CorrectiveAction,
  type CorrectiveActionStatus,
  type CorrectiveActionVerification,
  type CorrectiveActionView,
} from '@shared/schemas'
import { isOverdue, statusChangeProblem, withStatusChange } from '@shared/program/status'
import { AppError } from '../lib/errors'
import { exists, writeFileAtomic } from '../lib/fs'
import { newId, nowIso } from '../lib/ids'
import {
  announce,
  jsonText,
  loadProgram,
  programPaths,
  readRevisioned,
  revisionOf,
  updateProgram,
  withProgramLock,
} from './store'

export interface ActionFilter {
  statuses?: CorrectiveActionStatus[]
  capability?: string
  ownerName?: string
  projectId?: string
  overdueOnly?: boolean
}

export interface ActionList {
  actions: CorrectiveActionView[]
  /** Files that could not be read, so a damaged file is shown rather than hidden. */
  problems: string[]
}

const READ_BATCH = 64

async function readOne(
  root: string,
  file: string,
): Promise<CorrectiveActionView | { problem: string }> {
  try {
    const { value, revision } = await readRevisioned(
      programPaths(root).action(file.replace(/\.json$/, '')),
      CorrectiveAction,
    )
    return { action: value, revision }
  } catch (e) {
    return { problem: `${file}: ${e instanceof AppError ? e.message : String(e)}` }
  }
}

/** Every readable action, ordered by number. */
export async function listAllActions(root: string): Promise<ActionList> {
  let names: string[]
  try {
    names = (await fs.readdir(programPaths(root).actions)).filter((n) => /^[A-Za-z0-9_-]+\.json$/.test(n))
  } catch {
    return { actions: [], problems: [] }
  }
  const actions: CorrectiveActionView[] = []
  const problems: string[] = []
  for (let i = 0; i < names.length; i += READ_BATCH) {
    const batch = await Promise.all(names.slice(i, i + READ_BATCH).map((n) => readOne(root, n)))
    for (const r of batch) {
      if ('problem' in r) problems.push(r.problem)
      else actions.push(r)
    }
  }
  actions.sort(
    (a, b) =>
      (a.action.number ?? Number.MAX_SAFE_INTEGER) - (b.action.number ?? Number.MAX_SAFE_INTEGER) ||
      a.action.createdAt.localeCompare(b.action.createdAt),
  )
  return { actions, problems }
}

export function applyFilter(
  views: CorrectiveActionView[],
  filter: ActionFilter | undefined,
  today: string,
): CorrectiveActionView[] {
  if (!filter) return views
  return views.filter(({ action: a }) => {
    if (filter.statuses?.length && !filter.statuses.includes(a.status)) return false
    if (filter.capability && !a.coreCapabilities.includes(filter.capability as never)) return false
    if (filter.ownerName && a.owner.name !== filter.ownerName) return false
    if (filter.projectId && a.source.projectId !== filter.projectId) return false
    if (filter.overdueOnly && !isOverdue(a, today)) return false
    return true
  })
}

export async function listActions(root: string, filter?: ActionFilter): Promise<ActionList> {
  const all = await listAllActions(root)
  return {
    problems: all.problems,
    actions: applyFilter(all.actions, filter, nowIso().slice(0, 10)),
  }
}

export async function getAction(root: string, id: string): Promise<CorrectiveActionView> {
  const { value, revision } = await readRevisioned(programPaths(root).action(id), CorrectiveAction)
  return { action: value, revision }
}

async function writeAction(root: string, action: CorrectiveAction): Promise<CorrectiveActionView> {
  const text = jsonText(CorrectiveAction.parse(action))
  await writeFileAtomic(programPaths(root).action(action.id), text)
  return { action: CorrectiveAction.parse(action), revision: revisionOf(text) }
}

/** Reserve `count` consecutive action numbers; they are never reused. */
async function reserveNumbers(root: string, count: number): Promise<number[]> {
  let first = 1
  await updateProgram(root, (p) => {
    first = p.nextActionNumber
    p.nextActionNumber += count
  })
  return Array.from({ length: count }, (_, i) => first + i)
}

function newActionBase(programId: string, action: CorrectiveAction, now: string): CorrectiveAction {
  return {
    ...action,
    programId,
    status: 'open',
    verifications: [],
    history: [{ at: now, to: 'open', note: 'Created' }],
    createdAt: now,
    updatedAt: now,
  }
}

/** Create one action (a new id and number); used by the AAR import and the editor. */
export async function createAction(
  root: string,
  input: CorrectiveAction,
): Promise<CorrectiveActionView> {
  return createWithId(root, { ...input, id: newId() })
}

/**
 * Save an edit. Status, history and verifications are kept from the stored file: they change only
 * through changeStatus, so the history cannot be rewritten by an edit.
 */
export async function saveAction(
  root: string,
  incoming: CorrectiveAction,
  baseRevision?: string,
): Promise<CorrectiveActionView> {
  const parsed = CorrectiveAction.parse(incoming)
  const exists_ = await exists(programPaths(root).action(parsed.id))
  if (!exists_) return createWithId(root, parsed)
  const view = await withProgramLock(root, async () => {
    const stored = await getAction(root, parsed.id)
    if (baseRevision !== stored.revision)
      throw new AppError('CONFLICT', 'This corrective action was changed by someone else.', {
        theirs: stored,
      })
    const next: CorrectiveAction = {
      ...parsed,
      programId: stored.action.programId,
      number: stored.action.number,
      status: stored.action.status,
      history: stored.action.history,
      verifications: stored.action.verifications,
      createdAt: stored.action.createdAt,
      updatedAt: nowIso(),
    }
    return writeAction(root, next)
  })
  announce(root, 'actions')
  return view
}

async function createWithId(root: string, parsed: CorrectiveAction): Promise<CorrectiveActionView> {
  const program = await loadProgram(root)
  const [number] = await reserveNumbers(root, 1)
  const view = await withProgramLock(root, () =>
    writeAction(root, newActionBase(program.id, { ...parsed, number }, nowIso())),
  )
  announce(root, 'actions')
  return view
}

/** Change the status of several actions at once; all are checked before any is written. */
export async function changeStatus(
  root: string,
  ids: string[],
  to: CorrectiveActionStatus,
  note: string,
  verification?: CorrectiveActionVerification,
): Promise<CorrectiveActionView[]> {
  const out = await withProgramLock(root, async () => {
    const stored = await Promise.all(ids.map((id) => getAction(root, id)))
    for (const { action } of stored) {
      const problem = statusChangeProblem(action.status, to, note, verification)
      if (problem) throw new AppError('VALIDATION', `${action.title}: ${problem}`)
    }
    const now = nowIso()
    return Promise.all(
      stored.map(({ action }) => writeAction(root, withStatusChange(action, to, note, now, verification))),
    )
  })
  announce(root, 'actions')
  return out
}

export interface BulkPatch {
  ownerName?: string
  ownerOrganization?: string
  dueDate?: string
  priority?: 'high' | 'medium' | 'low'
}

export async function bulkUpdate(
  root: string,
  ids: string[],
  patch: BulkPatch,
): Promise<CorrectiveActionView[]> {
  const out = await withProgramLock(root, async () => {
    const now = nowIso()
    return Promise.all(
      ids.map(async (id) => {
        const { action } = await getAction(root, id)
        const owner = {
          ...action.owner,
          ...(patch.ownerName !== undefined ? { name: patch.ownerName } : {}),
          ...(patch.ownerOrganization !== undefined ? { organization: patch.ownerOrganization } : {}),
        }
        return writeAction(root, {
          ...action,
          owner,
          ...(patch.dueDate !== undefined ? { dueDate: patch.dueDate } : {}),
          ...(patch.priority ? { priority: patch.priority } : {}),
          updatedAt: now,
        })
      }),
    )
  })
  announce(root, 'actions')
  return out
}

export async function deleteAction(root: string, id: string): Promise<void> {
  await withProgramLock(root, () => fs.rm(programPaths(resolve(root)).action(id), { force: true }))
  announce(root, 'actions')
}
